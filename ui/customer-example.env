# Save a separate file for each customer, for example customer-a.env.
# Use plain UTF-8 text. Keep the file private: it contains unencrypted API keys.
# In Connections, choose Load credentials from file. Values stay in app memory
# until the server stops or you change connections; projects and exports exclude them.
# This format also works with Use existing local settings / CLI --env-file.
# File uploads use only this file, without environment-variable substitution.

# Required: ZTB tenant API URL and API key
ZTB_API_BASE="https://YOUR_TENANT-api.goairgap.com/api/v3"
API_KEY="YOUR_API_KEY"

# Optional: set true and populate these settings if using ZPA.
# Choose the API URL for your organization's ZPA cloud.
ZPA_ENABLED=false
ZPA_BASE_URL="https://config.zpatwo.net"
ZPA_CLIENT_ID="YOUR_ZPA_CLIENT_ID"
ZPA_CLIENT_SECRET="YOUR_ZPA_CLIENT_SECRET"
# Customer ID can be blank if the authentication token supplies it.
ZPA_CUSTOMER_ID=""
ZPA_ENROLLMENT_CERT_NAME="Connector"

# No bearer tokens are needed. The tool obtains fresh tokens when connecting.
